{
  "base_model": "HuggingFaceTB/SmolLM2-135M-Instruct",
  "training": {
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "target_modules": [
      "q_proj",
      "v_proj"
    ],
    "num_epochs": 3,
    "per_device_train_batch_size": 4,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.0001,
    "warmup_ratio": 0.06,
    "max_steps": 0,
    "max_seq_length": 128,
    "bf16": false,
    "fp16": false,
    "seed": 7,
    "logging_steps": 10,
    "save_total_limit": 1
  }
}